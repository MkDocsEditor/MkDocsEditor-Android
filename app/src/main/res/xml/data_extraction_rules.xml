<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the encrypted sessions are useless without the Keystore key, which is never backed up -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_sessions.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_sessions.xml" />
    </device-transfer>
</data-extraction-rules>
